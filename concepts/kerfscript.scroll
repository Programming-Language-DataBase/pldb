example
  // A coaster with a hole, an engraved ring and a scored border.
  size = 90; // [60:5:120]
  
  difference() {
    circle(d = size);
    circle(d = 6);
  }
  engrave() difference() { circle(d = size - 16); circle(d = size - 22); }
  score() circle(d = size - 6);

example
  use <kerf/box>
  
  width = 120;
  depth = 80;
  height = 50;
  
  $thickness = 3;
  $kerf = 0.15;
  
  box([width, depth, height], lid = true);
